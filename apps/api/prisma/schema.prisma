// C2C Protocol API — Prisma schema（PostgreSQL）
// 设计依据 doc/实施方案.md §7：User/Agent/Event/VectorSnapshot/Proof。
// 幂等：Event.idempotencyKey 全局唯一（SDK eventId）；Proof.hash 全局唯一（keccak hex）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  walletAddress String   @unique
  agents        Agent[]
  createdAt     DateTime @default(now())
}

model Agent {
  id            String   @id @default(uuid())
  ownerId       String // User.id（ownerAddress 归属）
  owner         User     @relation(fields: [ownerId], references: [id])
  // 链上 AgentIdentity tokenId（本地 hardhat 为小整数；fuji 亦为顺序 id）
  chainAgentId  Int?     @unique
  ownerAddress  String // Path1 约束：owner = 事件签名身份（SDK signer 同一地址）
  name          String
  metadataURI   String?
  active        Boolean  @default(true)
  // 最近一次 Score 上链对账信息（indexer 回写）
  chainVerified Boolean  @default(false)
  lastScoreTx   String?
  createdAt     DateTime @default(now())
  events        Event[]
  snapshots     VectorSnapshot[]
  proofs        Proof[]
}

model Event {
  id             String   @id @default(uuid())
  idempotencyKey String   @unique // SDK 事件 eventId（全局幂等）
  agentId        String
  agent          Agent    @relation(fields: [agentId], references: [id])
  action         String // task.started | task.completed | task.failed | proof.submitted
  taskId         String
  payload        Json?
  ts             BigInt // 信封时间戳（epoch 秒）
  createdAt      DateTime @default(now())

  @@index([agentId, ts])
}

model VectorSnapshot {
  id             String   @id @default(uuid())
  agentId        String
  agent          Agent    @relation(fields: [agentId], references: [id])
  execution      Int
  reliability    Int
  quality        Int
  collaboration  Int
  composite      Int
  proofHash      String? // 链上 ReputationRegistry.proofHash
  txHash         String? // submitScore 交易
  updatedAt      DateTime @default(now())

  @@index([agentId, updatedAt])
}

model Proof {
  id          String   @id @default(uuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id])
  hash        String   @unique // keccak256(proofJson) = 链上 proofHash
  cid         String // Kubo CID 或 local:<hash>（Kubo 不可用降级）
  payloadJson Json // canonical proof JSON 原文（/verify 可字节级重算比对）
  createdAt   DateTime @default(now())
}

// 任务市场登记（V1：链下状态机 + TaskRegistry 链上审计登记；不做支付/撮合）。
// 状态机：OPEN → ASSIGNED → COMPLETED（发布者 CANCELLED 为旁路终态）。
// 门槛 minScore 由服务端读取链上 ReputationRegistry.compositeScore 校验通过后
// 才调 TaskRegistry.assignTask 登记领取。
model Task {
  id                 String    @id @default(uuid())
  externalId         String    @unique // 发布者业务 ID（taskHash 输入之一，可重算）
  title              String
  description        String?
  publisherAddr      String // 发布者 EVM 地址（小写）
  minScore           Int       @default(0) // 声誉门槛 0–10000
  status             String    @default("OPEN") // OPEN | ASSIGNED | COMPLETED | CANCELLED
  // 链上登记交易
  publishTx          String? // TaskRegistry.publishTask txHash
  assignTx           String? // TaskRegistry.assignTask txHash
  // 领取方（Agent）
  assignedAgentId    String? // Agent.id（链下 FK）
  assignedChainAgent Int? // AgentIdentity tokenId
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
}
