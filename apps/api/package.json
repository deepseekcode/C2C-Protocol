{
  "name": "@c2c/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test:e2e": "tsx --test test/e2e/app.e2e.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed:e2e": "tsx scripts/seed-e2e.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "@c2c/shared": "file:../../packages/shared",
    "@c2c/agent-sdk": "file:../../packages/agent-sdk",
    "@c2c/reputation-engine": "file:../../packages/reputation-engine",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.1",
    "prisma": "^5.22.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
